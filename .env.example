# Backend API Configuration
# Copy this file to .env and fill in your configuration
# For production, use: https://api.whataboutyou.net/api
# For local development, use: http://localhost:3200/api

VITE_API_URL=https://api.whataboutyou.net/api

# Firebase Configuration (Optional - for legacy features)
# Get these from: https://console.firebase.google.com/

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
